# The backend is not deployed yet, so a stand-in in the browser answers every
# /api call instead (src/lib/mockApi.ts). It is on unless this says otherwise,
# which is why the app runs with no .env file at all.
#
# Set this to false once the real backend is up, and the app goes straight back
# on the wire. Nothing else changes.
VITE_MOCK_API=true
